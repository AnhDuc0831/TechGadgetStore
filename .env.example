# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG MẪU (MẪU AN TOÀN)
# Sao chép file này thành .env và điền các key thật của bạn
# TUYỆT ĐỐI KHÔNG COMMIT FILE .env LÊN GITHUB!
# ==========================================

ASPNETCORE_ENVIRONMENT=Development

# Supabase PostgreSQL Connection String
# Lấy từ Supabase Dashboard: Project Settings -> Database -> Connection String (URI / Pooler)
ConnectionStrings__DefaultConnection=Host=aws-0-ap-northeast-2.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.your_project_id;Password=your_database_password;SSL Mode=Require;Trust Server Certificate=true;

# JWT Authentication
Jwt__Secret=your_jwt_secret_min_32_characters_here
Jwt__Issuer=https://your_project_id.supabase.co/auth/v1
Jwt__Audience=authenticated

# Cloudinary Media Storage
Cloudinary__CloudName=your_cloudinary_cloud_name
Cloudinary__ApiKey=your_cloudinary_api_key
Cloudinary__ApiSecret=your_cloudinary_api_secret

# Google Gemini AI
Gemini__ApiKey=your_gemini_api_key_here
Gemini__Model=gemini-flash-lite-latest
